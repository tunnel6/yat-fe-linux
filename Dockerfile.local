# ── Package pre-built binary into Docker image ───────────────────────────────
# musl (static) → Alpine base    gnu (dynamic) → Debian base
#
# Usage:
#   # musl
#   docker build -f Dockerfile.local --build-arg VARIANT=musl \
#     --build-arg RUST_TARGET=x86_64-unknown-linux-musl --platform linux/amd64 -t yat-client:local .
#
#   # gnu
#   docker build -f Dockerfile.local --build-arg VARIANT=gnu \
#     --build-arg RUST_TARGET=x86_64-unknown-linux-gnu --platform linux/amd64 -t yat-client:local .
#
#   docker run --rm --network host yat-client:local

ARG VARIANT=musl

# ── musl → Alpine ────────────────────────────────────────────────────────────
FROM registry.cn-beijing.aliyuncs.com/pei/alpine:3.20 AS musl-base
RUN apk add --no-cache ca-certificates wireguard-tools

# ── gnu → Debian slim (glibc) ────────────────────────────────────────────────
FROM registry.cn-beijing.aliyuncs.com/pei/debian:bookworm-slim AS gnu-base
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wireguard-tools tzdata && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apt-get purge -y tzdata && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai

# ── Final ────────────────────────────────────────────────────────────────────
FROM ${VARIANT}-base

ARG RUST_TARGET=x86_64-unknown-linux-musl

COPY target/${RUST_TARGET}/release/yat-client /usr/local/bin/yat-client

ENV YAT_LISTEN=0.0.0.0:9909
EXPOSE 9909

ENTRYPOINT ["yat-client"]
CMD ["serve"]
